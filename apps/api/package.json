{
  "name": "@vostivo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -b tsconfig.build.json && concurrently -k -n tsc,node \"tsc -b tsconfig.build.json -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "auth:local:generate-key": "tsx src/dev/generate-local-auth-key.ts",
    "auth:local:mint-jwt": "tsx src/dev/mint-local-dev-jwt.ts",
    "dev:seed-loading-capability": "tsx src/dev/seed-manual-loading-capability.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@vostivo/config": "workspace:*",
    "@vostivo/contracts": "workspace:*",
    "@vostivo/database": "workspace:*",
    "@vostivo/domain": "workspace:*",
    "@vostivo/observability": "workspace:*",
    "@vostivo/progression-application": "workspace:*",
    "@vostivo/training-engine": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "jose": "6.2.10",
    "pg-boss": "12.32.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
