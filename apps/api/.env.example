NODE_ENV=local
PORT=4000
# The least-privilege API runtime role (Security Hardening Follow-Up V1,
# "Postgres least privilege") — SELECT/INSERT/UPDATE/DELETE on the `app`
# schema only, no DDL, no role creation. Never the migration/admin role;
# see packages/database/.env.example for MIGRATION_DATABASE_URL and how
# this role is created (`pnpm db:bootstrap-roles`).
DATABASE_URL=postgres://vostivo_api:vostivo_api@localhost:5432/vostivo_dev
# Supabase project base URL — used only to derive the JWKS endpoint
# (<url>/auth/v1/.well-known/jwks.json) and expected issuer (<url>/auth/v1)
# for JWT verification. No secret/service-role/publishable key here. To
# accept real app sign-ins (Auth Slice C) point it at the dev cloud project
# and leave LOCAL_JWKS_PATH unset — the project must use asymmetric JWT
# signing keys (its JWKS must list a key). LOCAL_JWKS_PATH (NODE_ENV=local
# only) switches verification to locally minted dev tokens instead.
SUPABASE_URL=https://your-project-ref.supabase.co
# Generous, environment-configurable rate-limit defaults — see
# docs/audits/V1-ENGINEERING-SECURITY-BASELINE.md's "Rate limiting"
# section for the reasoning behind these numbers. Safe to omit; the
# fallback defaults below apply.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
