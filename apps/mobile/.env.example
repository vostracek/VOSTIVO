# EXPO_PUBLIC_-prefixed vars are the ONLY ones bundled into client JS by
# Expo — never rename these without the prefix, and never add a
# service-role/secret key here (spec section 24).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Plan/Workout API base URL this app talks to. No production
# deployment exists yet — this is required for local/native verification
# only.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# DEV/NATIVE-VERIFICATION ONLY — never set in a real build pipeline.
# Both of the following must be set together for the local test-JWT auth
# override to activate; leaving either unset (the default) means the app
# uses the real (deferred) Supabase auth path. Setting EXPO_PUBLIC_DEV_JWT
# while EXPO_PUBLIC_VOSTIVO_ENV is "production" (or unset) is a
# misconfiguration the app refuses to boot with, on purpose — see
# docs/architecture/PLAN-PRESCRIPTION.md.
EXPO_PUBLIC_VOSTIVO_ENV=local
EXPO_PUBLIC_DEV_JWT=
