NODE_ENV=local
# Progression Evaluation Orchestration V1 — the worker's first real
# database dependency. Always the least-privilege API RUNTIME role (same
# convention as apps/api/.env.example's DATABASE_URL) — the worker never
# runs schema migrations, so it never reads MIGRATION_DATABASE_URL.
DATABASE_URL=postgres://vostivo_api:vostivo_api@localhost:5432/vostivo_dev
