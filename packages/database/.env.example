NODE_ENV=local
# Local dev Postgres — see docker-compose.yml at the repo root.
#
# Two distinct roles (Security Hardening Follow-Up V1, "Postgres least
# privilege") — never conflate them:
#
# DATABASE_URL           the least-privilege API RUNTIME role. Used by
#                         `pnpm db:seed:dev-plan` (proves the runtime
#                         role's plain DML privileges are sufficient to
#                         seed fixture data) and by anything else that
#                         only ever needs ordinary row reads/writes.
# MIGRATION_DATABASE_URL  the migration/ADMIN role — schema owner, the
#                         only role with DDL. Used by `pnpm db:migrate`,
#                         `pnpm db:bootstrap-roles`, and
#                         `pnpm db:bootstrap-pgboss`. Never used by
#                         application runtime code.
DATABASE_URL=postgres://vostivo_api:vostivo_api@localhost:5432/vostivo_dev
MIGRATION_DATABASE_URL=postgres://vostivo:vostivo@localhost:5432/vostivo_dev
# Only read by `pnpm db:bootstrap-roles` — the password used to
# create/update the vostivo_api runtime role above. Not a real secret in
# local dev (matches the well-known vostivo/vostivo docker-compose
# convention); a production deployment must use a real generated value
# provisioned through its own secrets mechanism, never this placeholder.
VOSTIVO_API_DB_PASSWORD=vostivo_api
# Only read by `pnpm db:manual:reset` (packages/database/src/
# bootstrap-manual-db.ts) — a LOCAL-ONLY, exact-match-only target for the
# manual-smoke-test database. The script hard-refuses to run unless
# NODE_ENV=local, the host is local, and the database name is EXACTLY
# "vostivo_manual" — it will never touch vostivo_dev or any other
# database. DROPS AND RECREATES this exact database every time it runs.
MANUAL_DATABASE_URL=postgres://vostivo:vostivo@localhost:5432/vostivo_manual
